--- DPF/Makefile.base.mk
+++ ../DigiDrie/plugin/dpf/lib/DPF/Makefile.base.mk
@@ -59,11 +59,18 @@
 CPU_X86_64=true
 CPU_I386_OR_X86_64=true
 endif
+# `filter arm%` matches arm64 too. Apple Silicon's `uname -m` returns
+# `arm64`, which would otherwise wrongly land in the 32-bit ARM branch
+# below (and pick up -mfpu=neon-vfpv4 -mfloat-abi=hard, which Apple
+# clang rejects on arm64-apple-darwin). Exclude arm64 from CPU_ARM and
+# instead route both arm64 and aarch64 into CPU_AARCH64.
 ifneq (,$(filter arm%,$(TARGET_PROCESSOR)))
+ifeq (,$(filter arm64%,$(TARGET_PROCESSOR)))
 CPU_ARM=true
 CPU_ARM_OR_AARCH64=true
 endif
-ifneq (,$(filter aarch64%,$(TARGET_PROCESSOR)))
+endif
+ifneq (,$(filter arm64% aarch64%,$(TARGET_PROCESSOR)))
 CPU_AARCH64=true
 CPU_ARM_OR_AARCH64=true
 endif
